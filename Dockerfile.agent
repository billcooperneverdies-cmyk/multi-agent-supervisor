# Dockerfile — Main Agent Service
# LangGraph supervisor HTTP API (FastAPI/uvicorn) with LiteLLM routing.
#
# The default CMD serves the orchestrator.api FastAPI app (the only component
# exposing /health). The interactive CLI is still available explicitly:
#   docker run --rm -it <image> python -m orchestrator.agent
# The MCP tool server is spawned in-process by the agent via MCP_SERVER_CMD
# (stdio transport), so mcp_server/ is copied into this image too (BUG-025).

FROM python:3.12-slim-bookworm

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency definitions and install
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e "."

# Copy source code (orchestrator imports agents/ and spawns mcp_server/)
COPY orchestrator/ ./orchestrator/
COPY agents/ ./agents/
COPY mcp_server/ ./mcp_server/

# Agent API port (overridable; compose maps ${AGENT_PORT:-8000}:8000)
ENV AGENT_PORT=8000
EXPOSE 8000

# Health check against the API service (BUG-009: aligned with the CMD below)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${AGENT_PORT}/health || exit 1

# Default: serve the HTTP API. CLI: docker run ... python -m orchestrator.agent
CMD ["sh", "-c", "uvicorn orchestrator.api:app --host 0.0.0.0 --port ${AGENT_PORT}"]
