From: Principal Engineer <review@prod.harden>
Subject: [PATCH 04/10] HIGH: Structured agent routing with Pydantic output

String-matching LLM output is fragile and non-deterministic.
Use Pydantic-structured output to enforce valid routing decisions.

--- langgraph/state_machine.py
+++ langgraph/state_machine.py
@@ -48,12 +48,44 @@
 class RoutingDecision(BaseModel):
     """Structured routing decision from Alice."""
     next_agent: Literal["bob", "charlie", "diana", "human", "end"] = Field(
         ..., description="Which agent to route to next"
     )
     reason: str = Field(..., description="Brief reason for routing decision")
     task_for_next: str | None = Field(
         default=None, description="Specific task description for the next agent"
     )
 
+class QARoutingDecision(BaseModel):
+    """Structured routing decision from Diana (QA)."""
+    action: Literal["approve", "reject_frontend", "reject_backend", "escalate"] = Field(
+        ..., description="QA decision: approve, reject with target, or escalate"
+    )
+    reason: str = Field(..., description="Reason for the decision")
+    issue_details: str | None = Field(
+        default=None, description="If rejecting, specific issues found"
+    )
+
+class DevCompletion(BaseModel):
+    """Structured completion signal from Bob/Charlie."""
+    is_complete: bool = Field(..., description="Whether the assigned task is complete")
+    summary: str = Field(..., description="What was accomplished")
+    needs_human: bool = Field(default=False, description="Whether human input is needed")
+    human_question: str | None = Field(
+        default=None, description="Question for human if needs_human is true"
+    )
+
+def _get_llm_with_structured(model: str, schema: type):
+    """Get LLM configured for structured output with the given schema."""
+    llm = get_llm(model)
+    return llm.with_structured_output(schema)
+
 
