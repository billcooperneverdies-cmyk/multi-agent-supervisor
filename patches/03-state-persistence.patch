+async def _check_dependencies() -> dict[str, bool]:
+    """Check all downstream dependencies at startup."""
+    import httpx
+    results = {}
+    try:
+        litellm_base = os.environ.get("LITELLM_API_BASE", "http://localhost:4000")
+        async with httpx.AsyncClient(timeout=5.0) as c:
+            r = await c.get(f"{litellm_base}/health")
+            results["litellm"] = r.status_code == 200
+    except Exception:
+        results["litellm"] = False
+        logger.warning("LiteLLM proxy unreachable at startup")
+    try:
+        import asyncpg
+        db_url = os.environ.get("DATABASE_URL", "")
+        if db_url:
+            conn = await asyncpg.connect(db_url, timeout=5)
+            await conn.close()
+            results["postgres"] = True
+        else:
+            results["postgres"] = None
+    except Exception:
+        results["postgres"] = False
+        logger.warning("Postgres unreachable at startup")
+    return results
+
