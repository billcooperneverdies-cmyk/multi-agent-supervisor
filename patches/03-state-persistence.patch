+# ── Cleanup old tasks ──
+_TASK_TTL_SECONDS = 3600 * 24
+
+async def _cleanup_old_tasks():
+    """Remove completed/failed tasks older than TTL."""
+    now = time.time()
+    expired = [
+        tid for tid, task in _TASK_STORE.items()
+        if task.get("completed_at") and now - task["completed_at"] > _TASK_TTL_SECONDS
+    ]
+    for tid in expired:
+        del _TASK_STORE[tid]
+        logger.info(f"[cleanup] Removed expired task {tid}")
 
 
