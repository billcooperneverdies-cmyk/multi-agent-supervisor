 import httpx
 from pydantic import BaseModel, Field
 
+# ── Defer env var validation to runtime ──
 SLACK_API_BASE = "https://slack.com/api"
-SLACK_BOT_TOKEN = os.environ.get("SLACK_BOT_TOKEN")
-if not SLACK_BOT_TOKEN:
-    raise RuntimeError("SLACK_BOT_TOKEN environment variable is required.")
+SLACK_BOT_TOKEN: str | None = None
 
-DEFAULT_HEADERS = {
-    "Authorization": f"Bearer {SLACK_BOT_TOKEN}",
-    "Content-Type": "application/json; charset=utf-8",
-}
+def _get_slack_token() -> str:
+    global SLACK_BOT_TOKEN
+    if SLACK_BOT_TOKEN is None:
+        SLACK_BOT_TOKEN = os.environ.get("SLACK_BOT_TOKEN")
+        if not SLACK_BOT_TOKEN:
+            raise RuntimeError("SLACK_BOT_TOKEN environment variable is required.")
+    return SLACK_BOT_TOKEN
+
+def _get_headers() -> dict:
+    return {
+        "Authorization": f"Bearer {_get_slack_token()}",
+        "Content-Type": "application/json; charset=utf-8",
+    }
+
+# ── Shared HTTP client ──
+_SLACK_CLIENT: httpx.AsyncClient | None = None
+
+def get_slack_client() -> httpx.AsyncClient:
+    global _SLACK_CLIENT
+    if _SLACK_CLIENT is None or _SLACK_CLIENT.is_closed:
+        _SLACK_CLIENT = httpx.AsyncClient(
+            timeout=httpx.Timeout(15.0, connect=5.0),
+            limits=httpx.Limits(max_connections=10, max_keepalive_connections=5),
+        )
+    return _SLACK_CLIENT
+
+async def close_slack_client():
+    global _SLACK_CLIENT
+    if _SLACK_CLIENT and not _SLACK_CLIENT.is_closed:
+        await _SLACK_CLIENT.aclose()
+        _SLACK_CLIENT = None
+
+# ── Slack API response wrapper ──
+async def _slack_request(method: str, url: str, json: dict | None = None, params: dict | None = None) -> dict:
+    """Make a Slack API request with error handling."""
+    client = get_slack_client()
+    headers = _get_headers()
+    resp = await client.request(method, url, headers=headers, json=json, params=params)
+    resp.raise_for_status()
+    data = resp.json()
+    if not data.get("ok"):
+        error = data.get("error", "unknown_error")
+        raise RuntimeError(f"Slack API error: {error}")
+    return data
 
 
