-def get_llm(model: str = "gpt-4o") -> ChatOpenAI:
-    """通过 LiteLLM 代理获取 LLM。"""
-    import os
-    return ChatOpenAI(
-        model=model,
-        api_key=os.environ.get("LITELLM_API_KEY", "sk-litellm-master-key"),
-        base_url=f"{os.environ.get('LITELLM_API_BASE', 'http://localhost:4000')}/v1",
-        temperature=0.2,
-    )
+
+_LLM_CACHE: dict[str, ChatOpenAI] = {}
+
+def get_llm(model: str = "gpt-4o") -> ChatOpenAI:
+    """通过 LiteLLM 代理获取 LLM（带缓存）。"""
+    if model in _LLM_CACHE:
+        return _LLM_CACHE[model]
+
+    import os
+    api_key = os.environ.get("LITELLM_API_KEY", "sk-litellm-master-key")
+    base_url = os.environ.get("LITELLM_API_BASE", "http://localhost:4000")
+
+    llm = ChatOpenAI(
+        model=model,
+        api_key=api_key,
+        base_url=f"{base_url}/v1",
+        temperature=0.2,
+        max_retries=3,
+        timeout=60,
+    )
+    _LLM_CACHE[model] = llm
+    return llm
+
+# ── Pre-bind tools once ──
+# TODO: Actually bind real tools here instead of empty list
+_TOOLS: list = []
+
+def get_llm_with_tools(model: str = "gpt-4o"):
+    """Get LLM with tools bound (cached)."""
+    llm = get_llm(model)
+    return llm.bind_tools(_TOOLS)
+
+def clear_llm_cache():
+    """Clear LLM cache (useful for testing)."""
+    _LLM_CACHE.clear()
 
 
