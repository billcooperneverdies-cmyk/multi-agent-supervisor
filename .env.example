# Multi-Agent Supervisor — environment template.
# Copy to .env and fill in values. Every variable below is actually consumed
# by the code, docker-compose.yml, configs/litellm_proxy.yaml or a Dockerfile
# (verified by tests/test_deploy_config.py). REQUIRED = startup fails fast
# without it; everything else has a working default.

# ── Required secrets (no defaults anywhere — BUG-005/006) ────────────────
# Master key of the LiteLLM proxy (also its admin-UI credential).
# Generate: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CHANGE-ME
# Key the agent service presents to the LiteLLM proxy (BUG-005: the code has
# NO default and refuses to start without it). Use the same value as
# LITELLM_MASTER_KEY, or a scoped virtual key created via the proxy.
LITELLM_API_KEY=sk-CHANGE-ME
# Password for the Postgres superuser (BUG-006: no default; the database is
# only reachable on the internal docker network).
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── LLM providers (consumed by configs/litellm_proxy.yaml in the proxy) ──
# OpenAI key for the gpt-4o model entry.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Anthropic key, only needed if you route to the claude-3-5-sonnet entry.
ANTHROPIC_API_KEY=

# ── Tool tokens (consumed by the MCP tool server the agent spawns) ───────
# GitHub PAT used by the MCP GitHub tools (repo contents/PR/issue scopes).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Slack bot token (xoxb-...) used by the MCP Slack tools.
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional API base overrides (GitHub Enterprise / Slack-compatible gateway).
GITHUB_API_BASE=https://api.github.com
SLACK_API_BASE=https://slack.com/api

# ── Postgres (compose builds DATABASE_URL from these) ────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=agent_db

# ── Agent service ────────────────────────────────────────────────────────
# Host port the agent API is published on; also the in-container uvicorn port.
AGENT_PORT=8000
# Base URL of the LiteLLM proxy for LOCAL runs (compose overrides it with
# http://litellm-proxy:4000 inside the agent container).
LITELLM_API_BASE=http://localhost:4000
# Optional LangGraph checkpointer DSN; empty = in-memory checkpoints.
# Compose sets postgresql://...@postgres:5432/... for the agent container.
DATABASE_URL=
# Command the agent uses to spawn the MCP tool server as a stdio subprocess
# (BUG-025; empty = agent nodes run without MCP tools).
MCP_SERVER_CMD=python -m mcp_server.main
# Max number of recent messages sent to the LLM per call (BUG-038).
HISTORY_WINDOW=20

# ── LiteLLM proxy service ────────────────────────────────────────────────
# Host port the proxy is published on.
LITELLM_PORT=4000

# ── MCP tool HTTP timeouts (seconds, consumed by mcp_server) ─────────────
MCP_HTTP_TIMEOUT=30
MCP_HTTP_CONNECT_TIMEOUT=5
